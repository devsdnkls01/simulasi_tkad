# Environment Variables for Platform Simulasi TKA/TKAD Sekolah Dasar

# Database Connection (PostgreSQL / Supabase / Neon)
# Contoh Supabase: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Contoh Local Postgres: postgresql://postgres:password@localhost:5432/tka_simulasi?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tka_simulasi?schema=public"

# Auth Secrets (Gunakan minimal 32 karakter acak untuk production)
JWT_SECRET="tka-simulasi-sd-secret-key-super-secure-token-2026"
ADMIN_JWT_SECRET="tka-simulasi-sd-admin-secret-key-super-secure-2026"

# App Info
NEXT_PUBLIC_APP_NAME="SIMULASI TKA/TKAD SD"
NEXT_PUBLIC_SCHOOL_NAME="SD NEGERI KALISALAK 01"
NEXT_PUBLIC_EXAM_DURATION_MINUTES="105"
