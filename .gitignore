# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*.local
.env

# prisma / sqlite db
prisma/*.db
prisma/*.db-journal

# IDE & agents
.agents/
.claude/
.cursor/
.devin/

# typescript
*.tsbuildinfo
next-env.d.ts

# Cloudinary CDN Managed Assets (Do NOT commit images to git)
/public/soal-images/
/public/uploads/
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.avif
!/public/logo-tegal.svg

